{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/src/index.js" },
    { "src": "/api-docs/(.*)", "dest": "/src/index.js" },
    { "src": "/api-docs", "dest": "/src/index.js" },
    { "src": "/api", "dest": "/src/index.js" },
    { "src": "/(.*)", "dest": "/src/index.js" }
  ],
  "functions": {
    "src/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
